{
  "name": "wiser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WISER — Water Intelligence System & Engine for Reconfiguration, empowered by AI",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @agent-excon/api --filter @agent-excon/web --filter @agent-excon/docs dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prelint": "pnpm --filter @agent-excon/docs generate",
    "lint": "oxlint --type-aware",
    "test": "vitest run && pnpm --recursive --if-present --filter './apps/*' test",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm compose:config",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "supabase:verify": "supabase db reset --local && supabase test db && supabase db lint --local --level warning --fail-on warning && supabase db advisors --local --type all --level warn --fail-on warn",
    "compose:config": "docker compose config --quiet",
    "compose:up": "docker compose up --build --wait",
    "compose:down": "docker compose down",
    "observability:config": "docker compose --profile observability config --quiet",
    "observability:up": "docker compose --profile observability up -d --build otel-collector telemetry-ingress tempo prometheus loki grafana",
    "observability:smoke": "node infrastructure/observability/smoke.mjs",
    "observability:down": "docker compose --profile observability stop telemetry-ingress otel-collector tempo prometheus loki grafana",
    "cookbook:scripted": "tsx cookbooks/workbuddy-yongding-tdd/scripts/run-cookbook.mjs --mode scripted",
    "cookbook:rework": "tsx cookbooks/workbuddy-yongding-tdd/scripts/run-cookbook.mjs --mode scripted --fault water-evidence-schema-once",
    "cookbook:workbuddy": "tsx cookbooks/workbuddy-yongding-tdd/scripts/run-cookbook.mjs --mode workbuddy",
    "codebuddy:install-skill": "node cookbooks/workbuddy-yongding-tdd/scripts/install-codebuddy-skill.mjs",
    "showcase": "tsx cookbooks/workbuddy-yongding-tdd/showcase/scripts/showcase.mjs",
    "showcase:preflight": "pnpm showcase preflight",
    "showcase:start": "pnpm showcase start",
    "showcase:status": "pnpm showcase status",
    "showcase:stop": "pnpm showcase stop",
    "stack:up": "pnpm supabase:start && pnpm compose:up",
    "stack:down": "pnpm compose:down && pnpm supabase:stop"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}

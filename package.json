{
  "name": "wiser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WISER — Water Intelligence System & Engine for Reconfiguration, empowered by AI",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @wiser/api --filter @wiser/web --filter @wiser/docs dev",
    "docpact:check": "docpact lint --root . --worktree --mode enforce --fail-on-uncovered-change --fail-on-stale-docs",
    "docpact:route": "docpact route --root .",
    "docpact:validate": "docpact validate-config --root . --strict",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prelint": "pnpm --filter @wiser/docs generate",
    "lint": "oxlint --type-aware",
    "test": "vitest run && pnpm --recursive --if-present --filter './apps/*' test",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm compose:config",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "supabase:verify": "supabase db reset --local && supabase test db && supabase db lint --local --level warning --fail-on warning && supabase db advisors --local --type all --level warn --fail-on warn",
    "compose:config": "docker compose config --quiet",
    "compose:up": "docker compose up --build --wait",
    "compose:down": "docker compose down",
    "data:up": "node scripts/data-foundation/up.mjs --profile data-foundation",
    "data:down": "node scripts/data-foundation/down.mjs",
    "data:reset": "node scripts/data-foundation/reset.mjs --volumes",
    "data:logs": "node scripts/data-foundation/logs.mjs",
    "data:migrate": "node scripts/data-foundation/migrate.mjs",
    "data:seed": "node scripts/data-foundation/seed.mjs",
    "data:smoke": "node scripts/data-foundation/smoke.mjs",
    "data:verify": "node scripts/data-foundation/verify.mjs",
    "stack:full:up": "node scripts/data-foundation/stack-full-up.mjs",
    "observability:config": "docker compose --profile observability config --quiet",
    "observability:up": "docker compose --profile observability up -d --build otel-collector telemetry-ingress tempo prometheus loki grafana",
    "observability:smoke": "node infrastructure/observability/smoke.mjs",
    "observability:down": "docker compose --profile observability stop telemetry-ingress otel-collector tempo prometheus loki grafana",
    "cookbook:scripted": "tsx examples/agent-excon/workbuddy-yongding-tdd/scripts/run-cookbook.mjs --mode scripted",
    "cookbook:rework": "tsx examples/agent-excon/workbuddy-yongding-tdd/scripts/run-cookbook.mjs --mode scripted --fault water-evidence-schema-once",
    "cookbook:workbuddy": "tsx examples/agent-excon/workbuddy-yongding-tdd/scripts/run-cookbook.mjs --mode workbuddy",
    "codebuddy:install-skill": "node examples/agent-excon/workbuddy-yongding-tdd/scripts/install-codebuddy-skill.mjs",
    "showcase": "tsx examples/agent-excon/workbuddy-yongding-tdd/showcase/scripts/showcase.mjs",
    "showcase:preflight": "pnpm showcase preflight",
    "showcase:start": "pnpm showcase start",
    "showcase:status": "pnpm showcase status",
    "showcase:stop": "pnpm showcase stop",
    "stack:up": "pnpm supabase:start && pnpm compose:up",
    "stack:down": "pnpm compose:down && pnpm supabase:stop"
  },
  "devDependencies": {
    "@agent-excon/scenarios": "workspace:*",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}

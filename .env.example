# Browser-safe Supabase values only. Never expose a secret or service-role key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side database connection for trusted application transactions.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# trusted-local-codex (default on a developer host), fake (tests/CI), or openai-compatible
AI_PROVIDER=trusted-local-codex
CODEX_MODEL=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

AGENT_EXCON_API_URL=http://127.0.0.1:3000
AGENT_EXCON_API_KEY=

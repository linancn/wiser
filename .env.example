# Browser-safe Supabase values only. Never expose a secret or service-role key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shared WISER server-side Auth. Production requires `supabase`; local
# compatibility may use `off` until an interactive Supabase session is needed.
WISER_AUTH_MODE=off
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_PUBLISHABLE_KEY=
# JSON key ring: {"activeKeyId":"primary-YYYY-MM","keys":{"primary-YYYY-MM":"<unpadded-base64url-of-32+-random-bytes>"}}
WISER_DELEGATED_CREDENTIAL_HMAC_KEYS=

# Durable Agent EXCON v2 runtime. `stack:full:up` provisions the local runtime
# role and ignored `.wiser/` key material; production must inject managed
# credentials and retain every historical lease HMAC key needed for replay.
EXCON_V2_MODE=postgres
EXCON_JOURNAL_DATABASE_URL=
EXCON_LEASE_HMAC_KEYS=
EXCON_TENANT_ID=b1000000-0000-4000-8000-000000000001
EXCON_PROJECT_ID=b2000000-0000-4000-8000-000000000001
EXCON_PURPOSE=excon-api

# Server-side database connection for trusted application transactions.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres

# trusted-local-codex (default on a developer host), fake (tests/CI), or openai-compatible
AI_PROVIDER=trusted-local-codex
CODEX_MODEL=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

API_HOST=127.0.0.1
API_PORT=3001
API_CORS_ORIGIN=http://127.0.0.1:3000
AGENT_EXCON_PARTICIPANT_TOKEN=local-demo-participant-token
AGENT_EXCON_OPERATOR_TOKEN=local-demo-operator-token

# Participant-side Skill/MCP settings. v2 is the default; obtain a short-lived
# credential bound to one concrete RunAgent before starting the MCP adapter.
AGENT_EXCON_PROTOCOL_VERSION=v2
AGENT_EXCON_API_URL=http://127.0.0.1:3001/api/v2/
AGENT_EXCON_API_KEY=

# Used only when an operator explicitly assigns a legacy v1 Episode:
# AGENT_EXCON_PROTOCOL_VERSION=v1
# AGENT_EXCON_API_URL=http://127.0.0.1:3001/api/v1/
# AGENT_EXCON_API_KEY=local-demo-participant-token
AGENT_EXCON_PARTICIPANT_VERSION_ID=40000000-0000-4000-8000-000000000001

# Web read model. `live` fails closed when the v2 API or server-only operator
# token is unavailable; use `reference` only for the committed design preview.
AGENT_EXCON_WEB_DATA_MODE=live
AGENT_EXCON_API_INTERNAL_URL=http://127.0.0.1:3001
WISER_WEB_OPERATOR_TOKEN=local-demo-operator-token
WISER_DATA_API_INTERNAL_URL=http://127.0.0.1:3001
WISER_DATA_TENANT_ID=b1000000-0000-4000-8000-000000000001
WISER_DATA_PROJECT_ID=b2000000-0000-4000-8000-000000000001
WISER_DATA_PURPOSE=data-steward-console
WISER_DATA_REQUEST_TIMEOUT_MS=8000
WISER_DATA_RESPONSE_LIMIT_BYTES=4194304

# Data Foundation authority plane. Canonical runtime names use DATA_*.
# Server credentials are intentionally blank; generate local-only values before
# starting the data-foundation profile. Deprecated WISER_DATA_* aliases remain
# accepted by the current Worker/Object Store loaders during migration only.
DATA_DATABASE_URL=
DATA_DATABASE_MIGRATION_URL=
DATA_POSTGRES_PASSWORD=
DATA_API_DATABASE_PASSWORD=
DATA_WORKER_DATABASE_PASSWORD=
DATA_GIS_DATABASE_PASSWORD=
DATA_TENANT_ID=
DATA_PROJECT_ID=
DATA_MAX_SECURITY_LEVEL=L0_PUBLIC
DATA_POLICY_VERSION=1

DATA_S3_ENDPOINT=http://127.0.0.1:18333
DATA_S3_PUBLIC_ENDPOINT=http://127.0.0.1:18333
DATA_S3_REGION=us-east-1
DATA_S3_ACCESS_KEY_ID=
DATA_S3_SECRET_ACCESS_KEY=
DATA_S3_BUCKET=wiser-authority

WEAVIATE_URL=http://127.0.0.1:18080
WEAVIATE_API_KEY=
OPENSEARCH_URL=https://127.0.0.1:19200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
NEO4J_URL=http://127.0.0.1:17474
NEO4J_USERNAME=
NEO4J_PASSWORD=
# GIS backends are Compose-internal and are reachable only through the API.
GEOSERVER_URL=http://geoserver:8080/geoserver
GEOSERVER_USERNAME=
GEOSERVER_PASSWORD=
STAC_API_URL=http://stac-api:8080
TITILER_URL=http://titiler:80
MARTIN_URL=http://martin:3000
TIKA_URL=http://127.0.0.1:19998
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=13310

DATA_WORKER_ID=data-worker-local-1
DATA_WORKER_ACTOR_ID=b6000000-0000-4000-8000-000000000001
DATA_WORKER_CLAIM_LIMIT=8
DATA_WORKER_HEALTH_HOST=127.0.0.1
DATA_WORKER_HEALTH_PORT=13003
DATA_JOB_LEASE_SECONDS=120
DATA_JOB_HEARTBEAT_SECONDS=30
DATA_JOB_POLL_INTERVAL_MS=1000
DATA_INGESTION_MAX_OBJECT_BYTES=16777216
DATA_INGESTION_MIN_QUALITY_SCORE=0.75
DATA_INGESTION_MIN_AI_CONFIDENCE=0.8
DATA_CLAMAV_HOST=127.0.0.1
DATA_CLAMAV_PORT=13310
DATA_CLAMAV_TIMEOUT_MS=30000
DATA_CLAMAV_MAX_RESPONSE_BYTES=4096
DATA_TIKA_ENDPOINT=http://127.0.0.1:19998
DATA_TIKA_TIMEOUT_MS=30000
DATA_TIKA_MAX_RESPONSE_BYTES=1048576
DATA_WEAVIATE_URL=http://127.0.0.1:18080
DATA_WEAVIATE_API_KEY=
DATA_OPENSEARCH_URL=https://127.0.0.1:19200
DATA_OPENSEARCH_USERNAME=admin
DATA_OPENSEARCH_PASSWORD=
DATA_NEO4J_URL=http://127.0.0.1:17474
DATA_NEO4J_DATABASE=neo4j
DATA_NEO4J_USERNAME=neo4j
DATA_NEO4J_PASSWORD=
DATA_STAC_API_URL=http://stac-api:8080
DATA_GEOSERVER_URL=http://geoserver:8080
DATA_TITILER_URL=http://titiler:80
DATA_MARTIN_URL=http://martin:3000
DATA_STAC_BEARER_TOKEN=
DATA_STAC_ASSET_BASE_URL=http://127.0.0.1:3001
DATA_PROJECTION_CONSUMER_NAME=data-worker-projection-v1
DATA_PROJECTION_BATCH_LIMIT=8
DATA_PROJECTION_POLL_INTERVAL_MS=1000
DATA_PROJECTION_HTTP_TIMEOUT_MS=30000
DATA_PROJECTION_HTTP_MAX_RESPONSE_BYTES=1048576
DATA_PROJECTION_CACHE_EVENTS=32
DATA_FAKE_EMBEDDING_DIMENSIONS=32
DATA_FAKE_EMBEDDING_VERSION=1.0.0-fixture
DATA_PUBLICATION_WAIT_TIMEOUT_MS=90000
DATA_PUBLICATION_WAIT_POLL_MS=250

DATA_MCP_TRANSPORT=streamable-http
DATA_MCP_HOST=127.0.0.1
DATA_MCP_PORT=3004
DATA_MCP_BEARER_TOKEN=
DATA_API_URL=http://127.0.0.1:3001/api/data/v1/
DATA_API_BEARER_TOKEN=
DATA_PURPOSE=data-foundation-smoke

# Evaluation worker.
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=8081

# Optional local-only OpenTelemetry/Grafana profile. Production telemetry must
# enter through the authenticated WISER ingress rather than a public Collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
WISER_TELEMETRY_INGRESS_URL=http://127.0.0.1:14318
WISER_TELEMETRY_LOCAL_TOKEN=local-participant-telemetry-token-0001
WISER_TELEMETRY_TOKEN_PEPPER=replace-with-a-long-random-production-secret
WISER_GRAFANA_ADMIN_USER=admin
WISER_GRAFANA_ADMIN_PASSWORD=local-observability-only

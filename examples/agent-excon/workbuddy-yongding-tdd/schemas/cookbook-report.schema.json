{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiser.local/schemas/workbuddy-cookbook-report.schema.json",
  "title": "WISER WorkBuddy Cookbook report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cookbookId",
    "profile",
    "protocolVersion",
    "status",
    "runId",
    "scenarioVersionId",
    "participantResults",
    "authoritative",
    "observability",
    "tddCycle",
    "artifacts",
    "diagnostic"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cookbookId": { "const": "workbuddy-yongding-four-agent-tdd" },
    "profile": { "enum": ["scripted-ci", "workbuddy-live-tdd"] },
    "protocolVersion": { "const": "v2" },
    "status": { "enum": ["passed", "failed"] },
    "runId": { "type": ["string", "null"] },
    "scenarioVersionId": { "type": ["string", "null"] },
    "participantResults": { "type": "array", "maxItems": 4 },
    "authoritative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluations",
        "releasedBarriers",
        "eventCount",
        "lastRunSeq",
        "interactions"
      ],
      "properties": {
        "evaluations": { "type": "array", "minItems": 0 },
        "releasedBarriers": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "eventCount": { "type": "integer", "minimum": 0 },
        "lastRunSeq": { "type": ["integer", "null"], "minimum": 1 },
        "interactions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interactionCount",
            "handoffCount",
            "closedHandoffCount",
            "distinctHandoffSenderCount",
            "requestCount",
            "respondedRequestCount",
            "responseCount",
            "distinctResponseSenderCount",
            "openRequestCount",
            "acknowledgedDeliveryCount"
          ],
          "properties": {
            "interactionCount": { "type": "integer", "minimum": 0 },
            "handoffCount": { "type": "integer", "minimum": 0 },
            "closedHandoffCount": { "type": "integer", "minimum": 0 },
            "distinctHandoffSenderCount": {
              "type": "integer",
              "minimum": 0
            },
            "requestCount": { "type": "integer", "minimum": 0 },
            "respondedRequestCount": { "type": "integer", "minimum": 0 },
            "responseCount": { "type": "integer", "minimum": 0 },
            "distinctResponseSenderCount": {
              "type": "integer",
              "minimum": 0
            },
            "openRequestCount": { "type": "integer", "minimum": 0 },
            "acknowledgedDeliveryCount": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bestEffort",
        "gap",
        "boundaryCoverage",
        "participantTelemetryMode",
        "platformObservedSpanCount",
        "participantReportedSpanCount",
        "droppedSpanCount",
        "lateSpanCount",
        "traceCount"
      ],
      "properties": {
        "bestEffort": { "const": true },
        "gap": { "type": "boolean" },
        "boundaryCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "participantTelemetryMode": {
          "enum": ["none", "partial", "instrumented"]
        },
        "platformObservedSpanCount": { "type": "integer", "minimum": 0 },
        "participantReportedSpanCount": { "type": "integer", "minimum": 0 },
        "droppedSpanCount": { "type": "integer", "minimum": 0 },
        "lateSpanCount": { "type": "integer", "minimum": 0 },
        "traceCount": { "type": "integer", "minimum": 0 }
      }
    },
    "tddCycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["injectedFault", "reworkObserved", "greenAccepted"],
      "properties": {
        "injectedFault": {
          "enum": [null, "water-evidence-schema-once"]
        },
        "reworkObserved": { "type": "boolean" },
        "greenAccepted": { "type": "boolean" }
      }
    },
    "artifacts": { "type": "object" },
    "diagnostic": { "type": ["string", "null"] }
  }
}

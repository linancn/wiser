{
  "name": "@wiser/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared MCP composition host for WISER HTTP capabilities",
  "license": "MIT",
  "bin": {
    "wiser-mcp": "dist/index.js",
    "agent-excon-mcp-server": "dist/index.js"
  },
  "exports": {
    ".": "./dist/server.js",
    "./http-client": "./dist/http-client.js",
    "./http-server": "./dist/http-server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:http": "tsx src/http-main.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http-main.js",
    "test": "vitest run test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-excon/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "4.23.12",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  }
}

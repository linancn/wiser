{
  "name": "agent-excon-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local stdio MCP adapter for the Agent EXCON HTTP API",
  "license": "MIT",
  "bin": {
    "agent-excon-mcp-server": "dist/index.js"
  },
  "exports": {
    ".": "./dist/server.js",
    "./http-client": "./dist/http-client.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-excon/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  }
}

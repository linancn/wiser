{
  "name": "@agent-excon/telemetry-ingress",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authenticated OTLP/HTTP ingress for participant-reported WISER Agent EXCON telemetry",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12",
    "typescript": "catalog:",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  }
}

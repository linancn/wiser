{
  "name": "@wiser/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared HTTP composition host for WISER product systems",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/main.ts",
    "lab": "tsx src/local-lab-main.ts",
    "start": "node dist/main.js",
    "start:lab": "node dist/local-lab-main.js",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-excon/contracts": "workspace:*",
    "@agent-excon/core": "workspace:*",
    "@agent-excon/scenarios": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/swagger": "9.8.1",
    "@supabase/supabase-js": "2.112.3",
    "@wiser/data-contracts": "workspace:*",
    "@wiser/data-infra": "workspace:*",
    "@wiser/platform-auth": "workspace:*",
    "@wiser/platform-contracts": "workspace:*",
    "fastify": "5.12.1",
    "graphql": "16.14.2",
    "mercurius": "16.10.0",
    "pg": "8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12",
    "typescript": "catalog:",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  }
}

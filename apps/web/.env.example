# Deterministic design preview (default)
AGENT_EXCON_WEB_DATA_MODE=reference

# Unified Auth is optional only in local development and test.
WISER_AUTH_MODE=off

# Enable the same Supabase Auth authority used by every WISER system.
# WISER_AUTH_MODE=supabase
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-the-local-publishable-key
# Never place a secret key or service-role key in NEXT_PUBLIC_*.

# Live server-only reads
# AGENT_EXCON_WEB_DATA_MODE=live
# AGENT_EXCON_API_INTERNAL_URL=http://127.0.0.1:3001
# WISER_WEB_OPERATOR_TOKEN=replace-with-a-dedicated-operator-token
